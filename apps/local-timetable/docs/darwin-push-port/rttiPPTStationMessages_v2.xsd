<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ct="http://www.thalesgroup.com/rtti/PushPort/CommonTypes/v1" 
           xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           xmlns:sm1="http://www.thalesgroup.com/rtti/PushPort/StationMessages/v1" 
           xmlns:tns="http://www.hitachirail.com/rtti/PushPort/StationMessages/v2" 
           targetNamespace="http://www.hitachirail.com/rtti/PushPort/StationMessages/v2" 
           elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
  <!--  Copyright (c) 2026 RDG & Hitachi -->
	<!--  Project 753 ATOC REAL TIME TRAIN INFORMATION -->
	<!--  Project WA063A0 ATOC DARWIN -->
	<!--  PUSH PORTS STATION MESSAGES SCHEMA -->
	<!--  
  14/01/2026	Version 2: Add subcategory.
	-->
	<xs:import namespace="http://www.thalesgroup.com/rtti/PushPort/CommonTypes/v1" schemaLocation="rttiPPTCommonTypes_V1.xsd"/>
  <xs:import namespace="http://www.thalesgroup.com/rtti/PushPort/StationMessages/v1" schemaLocation="rttiPPTStationMessages_v1.xsd"/>
  <!-- Simple Types -->
  <xs:simpleType name="MsgSubCategoryType">
    <xs:annotation>
      <xs:documentation>The category of operator message</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Lifts"/>
      <xs:enumeration value="NotSpecified"/>
    </xs:restriction>
  </xs:simpleType>
	<!-- Complex Types -->
  <xs:complexType name="StationMessage">
    <xs:annotation>
      <xs:documentation>Darwin Workstation Station Message</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Station" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>The Stations the message is being applied to</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="crs" type="ct:CrsType" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="Msg">
        <xs:annotation>
          <xs:documentation>The content of the message</xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
          <xs:choice>
            <xs:element ref="sm1:p" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element ref="sm1:a" minOccurs="0" maxOccurs="unbounded"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:int" use="required"/>
    <xs:attribute name="cat" type="sm1:MsgCategoryType" use="required">
      <xs:annotation>
        <xs:documentation>The category of message</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="subcat" type="tns:MsgSubCategoryType" use="required">
      <xs:annotation>
        <xs:documentation>The category of message</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sev" type="sm1:MsgSeverityType" use="required">
      <xs:annotation>
        <xs:documentation>The severity of the message</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="suppress" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Whether the train running information is suppressed to the public</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
</xs:schema>

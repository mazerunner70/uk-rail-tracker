{
  "name": "local-timetable-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "METRO_LAYOUT_ENGINE=geo node --import tsx --test test/mca-load/*.test.ts test/timetable-query/*.test.ts test/kafka-overlay/*.test.ts",
    "test:mca-load": "METRO_LAYOUT_ENGINE=geo node --import tsx --test test/mca-load/*.test.ts",
    "test:timetable-query": "METRO_LAYOUT_ENGINE=geo node --import tsx --test test/timetable-query/*.test.ts",
    "test:kafka-overlay": "METRO_LAYOUT_ENGINE=geo node --import tsx --test test/kafka-overlay/*.test.ts",
    "test:metro-layout": "METRO_LAYOUT_ENGINE=geo METRO_LAYOUT_PYTHON=${METRO_LAYOUT_PYTHON:-python3} node --import tsx --test test/timetable-query/metroLayoutBridge.test.ts test/timetable-query/metroLayoutMilp.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

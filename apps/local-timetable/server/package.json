{
  "name": "local-timetable-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --import tsx --test test/mca-load/*.test.ts test/timetable-query/*.test.ts",
    "test:mca-load": "node --import tsx --test test/mca-load/*.test.ts",
    "test:timetable-query": "node --import tsx --test test/timetable-query/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}

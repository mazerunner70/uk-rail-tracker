# Optional live harvest against RDM Darwin PubSub Kafka (not required for demo/tests).
# Copy values from server/poc/kafka/.env if you already have RDM credentials.
# Never commit real secrets.

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_KEY=
KAFKA_CONSUMER_SECRET=
KAFKA_TOPIC_JSON=

# Harvest stop rule (defaults match requirements: 20 LM events OR 2 hours)
SCHEDULE_HARVEST_MAX_LM_EVENTS=20
SCHEDULE_HARVEST_MAX_SECONDS=7200

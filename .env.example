# Workspace-root Kafka / live-feed credentials (gitignored when copied to .env).
# Fill from RDM → Darwin PubSub product → Pub/Sub tab.
# Same key names as server/poc/kafka/.env.example — used by live-sched consume.

KAFKA_BOOTSTRAP_SERVERS=your-bootstrap-server:9093
KAFKA_CONSUMER_KEY=your-consumer-key
KAFKA_CONSUMER_SECRET=your-consumer-secret
KAFKA_GROUP_ID=uk-rail-tracker-poc

# Optional: set if your OS CA bundle is not picked up automatically.
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/ca-certificates.crt

# Topic names from RDM (one per encoding — see product Pub/Sub tab).
KAFKA_TOPIC_JSON=
KAFKA_TOPIC_XML=
KAFKA_TOPIC_AVRO=

# MCA file for `live-sched load` (folder + file name).
# A relative SCHEDULE_DIR is resolved from the workspace root.
# Defaults when unset: server/poc/timetable / RJTTF944MCA.txt
SCHEDULE_DIR=server/poc/timetable
SCHEDULE_FILE=RJTTF944MCA.txt

# CFA daily updates for `live-sched cfa-update`.
# A relative CFA_WATCH_DIR is resolved from the workspace root.
# Default when unset: server/poc/live-sched/data/cfa-inbox
CFA_WATCH_DIR=server/poc/live-sched/data/cfa-inbox
# Bootstrap previous-load 3-digit code when the SQLite DB has no feed_meta row yet.
# First accepted update is then seed+1 mod 1000 (990 → 991).
FEED_SEQUENCE_SEED=990
